		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.0.0",
		"@eslint/js": "^10.0.1",
		"@hono/eslint-config": "^2.1.1",
		"@types/node": "^26.2.0",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^10.9.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.11.0",
		"prettier": "^3.9.6",
		"typescript-eslint": "^8.67.0",
		"vitest": "^4.1.11",
		"wrangler": "^4.110.0"
