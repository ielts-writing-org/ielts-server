{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"lib": ["ESNext"],
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx",
		"paths": {
			"@/*": ["./src/*"],
			"@shared/*": ["./src/shared/*"],
			"@modules/*": ["./src/modules/*"]
		},
		"verbatimModuleSyntax": true
	}
}
